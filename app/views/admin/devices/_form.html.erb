<% if device.errors.any? %>
  <div class="form-errors">
    <h3>Folgende Fehler verhinderten das Speichern:</h3>
    <ul>
      <% device.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, device], local: true do |f| %>
  <div class="form-group">
    <%= f.label :name, "Gerätename", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", placeholder: "z.B. Laptop 03 oder Canon EOS R6", required: true, autofocus: true %>
  </div>

  <div class="form-group">
    <%= f.label :category, "Kategorie", class: "form-label" %>
    <%= f.select :category, Device::CATEGORIES, { prompt: "Bitte Kategorie wählen" }, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :inventory_code, "Inventar-Code / Seriennummer", class: "form-label" %>
    <%= f.text_field :inventory_code, class: "form-control", placeholder: "z.B. LAP-005 oder CAM-010", required: true %>
    <div class="form-text">Eindeutige Identifikationsnummer im Inventar.</div>
  </div>

  <div class="form-group">
    <%= f.label :description, "Beschreibung & technische Details", class: "form-label" %>
    <%= f.text_area :description, rows: 4, class: "form-control", placeholder: "Spezifikationen, Zubehör, Besonderheiten..." %>
  </div>

  <div class="form-check" style="margin-top: 1rem; margin-bottom: 1.5rem;">
    <%= f.check_box :active, class: "form-check-input", id: "device_active_check" %>
    <%= f.label :active, "Gerät ist aktiv und kann im System ausgeliehen werden", class: "form-check-label", for: "device_active_check" %>
  </div>

  <div style="display: flex; gap: 0.75rem;">
    <%= f.submit "Speichern", class: "btn btn-primary" %>
    <%= link_to "Abbrechen", admin_devices_path, class: "btn btn-secondary" %>
  </div>
<% end %>
