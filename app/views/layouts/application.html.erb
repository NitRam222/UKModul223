<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for(:title) || "GearShare - Multiuser Geräteausleihe" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <%= link_to root_path, class: "brand" do %>
          <span>GearShare</span>
          <span class="brand-badge">M223</span>
        <% end %>

        <nav class="main-nav">
          <% if logged_in? %>
            <%= link_to "Geräte", root_path, class: "nav-link #{'active' if current_page?(root_path) || current_page?(devices_path)}" %>
            
            <%= link_to my_loans_path, class: "nav-link #{'active' if current_page?(my_loans_path)}" do %>
              Meine Ausleihen
              <% if current_user.active_loans.any? %>
                <span class="badge badge-warning" style="padding: 0.15rem 0.4rem; font-size: 0.7rem;"><%= current_user.active_loans.count %></span>
              <% end %>
            <% end %>

            <%= link_to "Profil", profile_path, class: "nav-link #{'active' if current_page?(profile_path)}" %>

            <% if admin? %>
              <div class="nav-admin-group">
                <span style="font-size: 0.7rem; font-weight: 700; color: #64748b; padding: 0 0.35rem; text-transform: uppercase;">Admin:</span>
                <%= link_to "Geräte", admin_devices_path, class: "nav-link #{'active' if request.path.start_with?('/admin/devices')}", title: "Geräteverwaltung" %>
                <%= link_to "Ausleihen", admin_loans_path, class: "nav-link #{'active' if request.path.start_with?('/admin/loans')}", title: "Alle Ausleihen" %>
                <%= link_to "Benutzer", admin_users_path, class: "nav-link #{'active' if request.path.start_with?('/admin/users')}", title: "Benutzerverwaltung" %>
                <%= link_to "Protokoll", admin_activity_logs_path, class: "nav-link #{'active' if request.path.start_with?('/admin/activity_logs')}", title: "Aktivitätsprotokoll" %>
              </div>
            <% end %>
          <% end %>
        </nav>

        <div class="user-nav">
          <% if logged_in? %>
            <div class="user-pill">
              <span><%= current_user.name %></span>
              <span class="role-tag <%= current_user.role %>"><%= current_user.role_name %></span>
            </div>
            <%= button_to "Abmelden", logout_path, method: :delete, class: "btn btn-secondary btn-sm" %>
          <% else %>
            <%= link_to "Anmelden", login_path, class: "btn btn-secondary btn-sm" %>
            <%= link_to "Registrieren", register_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </div>
    </header>

    <% if flash[:notice].present? || flash[:alert].present? %>
      <div class="flash-container">
        <% if flash[:notice] %>
          <div class="alert alert-notice">
            <span>✓ <%= flash[:notice] %></span>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="alert alert-alert">
            <span>⚠️ <%= flash[:alert] %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container" style="margin: 0 auto; padding: 0 1.5rem;">
        <p><strong>GearShare</strong> – Multiuser-Applikation für Geräteausleihe und Geräteverwaltung</p>
        <p style="margin-top: 0.25rem; font-size: 0.8rem; color: #94a3b8;">
          Modul 223: Multi-User-Applikationen objektorientiert realisieren | Autor: Martin Evers | Klasse: 24-223-E
        </p>
      </div>
    </footer>
  </body>
</html>
